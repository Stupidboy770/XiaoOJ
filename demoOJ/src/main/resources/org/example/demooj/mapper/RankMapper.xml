<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.example.demooj.mapper.RankMapper">
    <insert id="addRank">
        insert into competitionRank(competitionId,rankInfo) values (#{competitionId},#{rank})
    </insert>
    
    <select id="getRankById">
        select * from competitionRank where competitionId=#{competitionId}
    </select>

    <delete id="deleteRank">
        delete from competitionRank where competitionId=#{competitionId}
    </delete>
</mapper>